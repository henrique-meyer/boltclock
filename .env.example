# Copy to .env and fill in. Never commit .env.
PUBLIC_BASE_URL=http://localhost:8080
# Your own Google Maps Platform key (Maps JavaScript API + Places). Restrict it by HTTP referrer.
GOOGLE_MAPS_API_KEY=
# Required by api.weather.gov: identify your app and a contact
NWS_USER_AGENT=(BoltClock, you@example.com)

# The Azure deploy reads GOOGLE_MAPS_API_KEY and NWS_USER_AGENT from these same variables (infra/README.md).
