# Copy to .env and fill in. Never commit .env.
PUBLIC_BASE_URL=http://localhost:8080
# Your own Google Maps Platform browser key (Maps JavaScript API + Places API (New)), read at runtime by the
# location picker. Restrict it by HTTP referrer to your site and by API to those two (README, "Google Maps key").
GOOGLE_MAPS_API_KEY=
# Optional Map ID for the picker's map and pin (Google Cloud console, Map Management). Unset: Google's DEMO_MAP_ID.
# GOOGLE_MAPS_MAP_ID=
#
# Local development: `npm run dev` also reads .env.local (gitignored), and its values win over .env. Put a second
# key restricted to http://localhost:5173/* and http://localhost:8080/* there, so .env can keep the production key:
#   GOOGLE_MAPS_API_KEY=<your localhost key>
# Required by api.weather.gov: identify your app and a contact
NWS_USER_AGENT=(BoltClock, you@example.com)
# Port the server listens on. Defaults to 8080.
# PORT=8080
# Minutes after which a display session ends, for a demo that scales to zero (ADR 0003). 0 or unset: no limit.
# SESSION_LIMIT_MINUTES=0
# Table Storage endpoint of the flash tables (ADR 0004), e.g. https://<account>.table.core.windows.net.
# Set by Bicep in Azure; the app reads it with its managed identity. Unset: /api/stream answers 503.
# STRIKES_TABLE_ENDPOINT=
# true offers Simulation mode (the Simulate a strike and Simulate all clear buttons) in each display's settings, for
# demos and testing. Keep it unset on a real display: then there is no checkbox and no Simulate buttons.
# ALLOW_SIMULATION=false
# With ALLOW_SIMULATION on, the default for each display's Simulation mode checkbox; a device can change it.
# TEST_MODE=false
# true shows the display's top-right buttons as icons only; unset or false shows each icon with its label.
# BUTTON_ICONS_ONLY=false

# The Azure deploy reads GOOGLE_MAPS_API_KEY and NWS_USER_AGENT from these same variables (infra/README.md).

# Development only: the ElevenLabs key for the script in scripts/audio/ that renders the spoken announcements.
# The running app never reads it.
# ELEVENLABS_API_KEY=
