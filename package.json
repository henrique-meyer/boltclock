{
  "name": "boltclock",
  "version": "0.1.0",
  "private": true,
  "description": "Full-screen lightning alarm driven by NOAA GOES-19 GLM data.",
  "license": "SEE LICENSE IN LICENSE",
  "type": "module",
  "main": "dist/functions/glm-webhook.js",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "concurrently --names server,client --prefix-colors cyan,yellow \"npm:dev:server\" \"npm:dev:client\"",
    "dev:server": "tsx watch --env-file-if-exists=.env --env-file-if-exists=.env.local src/server/index.ts",
    "dev:client": "vite",
    "build": "tsc -p tsconfig.server.json && vite build",
    "start": "node dist/server/index.js",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "audio:sounds": "tsx scripts/audio/render-sounds.ts",
    "audio:speech": "tsx --env-file-if-exists=.env scripts/audio/render-speech.ts"
  },
  "dependencies": {
    "@azure/data-tables": "^13.3.2",
    "@azure/functions": "^4.16.5",
    "@azure/identity": "^4.14.0",
    "@fastify/static": "^10.1.6",
    "fastify": "^5.12.7",
    "h5wasm": "^0.10.3"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/google.maps": "^3.66.7",
    "@types/node": "^24.19.2",
    "concurrently": "^10.0.6",
    "eslint": "^10.13.0",
    "globals": "^17.13.0",
    "tsx": "^4.23.15",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.71.2",
    "vite": "^8.3.4",
    "vitest": "^5.0.5"
  }
}
